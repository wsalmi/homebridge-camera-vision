{
  "name": "homebridge-camera-vision",
  "version": "0.1.0",
  "description": "Homebridge camera platform with Apple HomeKit Secure Video recording, motion detection and a modern camera dashboard.",
  "author": "wsalmi (https://github.com/wsalmi)",
  "scripts": {
    "build": "npm run build --prefix homebridge-ui/ui",
    "lint": "concurrently \"npm run lint:homebridge-ui\" \"npm run lint:plugin\"",
    "lint:homebridge-ui": "npm run lint --prefix homebridge-ui/ui",
    "lint:plugin": "eslint .",
    "test": "node --test --test-reporter=spec",
    "watch": "npm run serve --prefix homebridge-ui/ui",
    "postinstall": "node scripts/sync-interface.js",
    "prepublishOnly": "npm install --package-lock-only && npm run lint && npm test && npm run build"
  },
  "main": "index.js",
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^0.0.19",
    "camera.ui": "1.1.17",
    "ffmpeg-for-homebridge": "0.0.9",
    "fs-extra": "10.1.0",
    "pick-port": "^1.0.0"
  },
  "devDependencies": {
    "@babel/core": "7.17.9",
    "@babel/eslint-parser": "7.17.0",
    "@babel/eslint-plugin": "7.17.7",
    "@homebridge/hap-nodejs": "^2.2.2",
    "concurrently": "7.1.0",
    "eslint": "^8.14.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-unicorn": "^42.0.0",
    "homebridge": "^2.4.0",
    "prettier": "^2.6.2"
  },
  "bugs": {
    "url": "https://github.com/wsalmi/homebridge-camera-vision/issues"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0",
    "homebridge": "^1.6.0 || ^2.0.0"
  },
  "homepage": "https://github.com/wsalmi/homebridge-camera-vision#readme",
  "keywords": [
    "camera",
    "homebridge-plugin",
    "motion",
    "detection",
    "ui",
    "rekognition",
    "interface",
    "webapp",
    "hsv",
    "homekit",
    "secure",
    "video"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wsalmi/homebridge-camera-vision.git"
  },
  "type": "module"
}
